# Copy to .env (repository root) and adjust. Every variable is optional except
# SUBWISE_JWT_SECRET, which must be changed before anyone else uses the app.

# --- Core ---
SUBWISE_ENV=development
SUBWISE_JWT_SECRET=change-me-to-a-long-random-string
# Leave empty to use <repo>/data
SUBWISE_DATA_DIR=
SUBWISE_COUNTRY=IN

# --- Local LLM (Ollama) ---
SUBWISE_OLLAMA_HOST=http://localhost:11434
SUBWISE_OLLAMA_MODEL=qwen2.5:3b
SUBWISE_LLM_TIMEOUT_S=60

# --- Optional web discovery (Tavily free tier). Empty = discovery off; app still works. ---
SUBWISE_TAVILY_API_KEY=

# --- Optional JavaScript rendering for pricing pages (requires `pip install -e ".[browser]"`) ---
SUBWISE_PLAYWRIGHT_ENABLED=false
